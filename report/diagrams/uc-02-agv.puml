@startuml uc-02-agv
' SRS Section II.1.3.3.2 — UCs for AGV Fleet Management
' Use cases taken verbatim from the UC table in Section II.1.3.2 (AGV-FM group).
!pragma layout smetana
!include uc-style.iuml
left to right direction

actor Admin as ADM
actor System as SYS
actor "FMS (openTCS)" as FMS

rectangle "SWES" {
  usecase "UC 1\nCreate AGV" as UC1
  usecase "UC 2\nUpdate AGV information" as UC2
  usecase "UC 3\nDelete AGV" as UC3
  usecase "UC 4\nView AGV list" as UC4
  usecase "UC 5\nView AGV details" as UC5
  usecase "UC 6\nConfigure critical\nbattery threshold" as UC6
  usecase "UC 7\nConfigure sufficient\nbattery threshold" as UC7
  usecase "UC 8\nEnable AGV to\naccept requests" as UC8
  usecase "UC 9\nDisable AGV from\naccepting requests" as UC9
  usecase "UC 10\nIgnore AGV from\nthe system" as UC10
  usecase "UC 11\nRestore ignored AGV" as UC11
  usecase "UC 12\nActivate / Deactivate AGV" as UC12
  usecase "UC 13\nHandle AGV\ndisconnection mid-task" as UC13
  usecase "UC 14\nFilter AGVs by status" as UC14
  usecase "UC 15\nView AGV\noperation history" as UC15
  usecase "UC 16\nView AGV error history" as UC16
}

ADM --> UC1
ADM --> UC2
ADM --> UC3
ADM --> UC4
ADM --> UC6
ADM --> UC7
ADM --> UC8
ADM --> UC9
ADM --> UC10
ADM --> UC11
ADM --> UC12
ADM --> UC14

SYS --> UC13
UC13 --> ADM
UC12 --> FMS
UC13 --> FMS

UC5 ..> UC4 : <<extend>>
UC15 ..> UC5 : <<extend>>
UC16 ..> UC5 : <<extend>>

legend bottom
  Every use case in this group is Admin only. UC 13 is driven by the fleet kernel
  rather than by a user, so System is its primary actor and Admin is notified.
endlegend
@enduml
