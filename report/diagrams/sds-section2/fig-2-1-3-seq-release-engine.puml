@startuml fig-2-1-3-seq-release-engine
' SDS Figure II-2.1.3 — Release Engine: release / block
' Verified against wes/src/cargo/release-engine.service.ts and
' dispatch-scheduler.service.ts flush() on 2026-08-09.
' Render: java -jar plantuml.jar -charset UTF-8 -tpng fig-2-1-3-seq-release-engine.puml
!include _style.iuml

actor "openTCS / FMS kernel" as Kernel
participant "KernelEventListener\n(ACL)" as Listener
participant DispatchScheduler
participant ReleaseEngineService
participant PickupDependencyService
participant ZoneGeometryService
participant TransportTaskService

group Trigger — any one starts the debounced flush
  alt a vehicle frees up (external kernel event)
    Kernel -> Listener: SSE — vehicle -> IDLE
    Listener -> DispatchScheduler: emit fms.vehicle.available -> schedule()
  else task created / status changed / 5s heartbeat (internal)
    Listener -> DispatchScheduler: debounced timer (1.5s window)
  end
end

note over DispatchScheduler
  flush() runs one pass, single-flight:
  parkClaims.reconcile -> legReconcile -> **release**
  -> assign -> charge -> park
end note

DispatchScheduler -> ReleaseEngineService: run()
ReleaseEngineService -> PickupDependencyService: evaluate() — all at-source tasks
PickupDependencyService -> ZoneGeometryService: computeMemberAxes(zone)
ZoneGeometryService --> PickupDependencyService: laneKey / depthKey per slot
PickupDependencyService -> PickupDependencyService: findBlocker(candidate, peers)\n[pure policy, BR-10]
PickupDependencyService --> ReleaseEngineService: PickupDecision[] {task, blocked, reason}

loop each decision
  alt blocked & status in {CREATED, READY_TO_ASSIGN}
    ReleaseEngineService -> TransportTaskService: changeStatus(task, BLOCKED)
  else not blocked & status in {CREATED, BLOCKED}
    ReleaseEngineService -> TransportTaskService: changeStatus(task, READY_TO_ASSIGN)
  end
end

note over ReleaseEngineService
  A task already in PICKING_UP is never revoked here.
  Preemption is the Lane Safety Guard's job
  (LaneSafetyService.preempt).
end note

note over ReleaseEngineService, TransportTaskService
  AssignmentEngine runs next in the same flush
  — see Figure II-2.2.2.
end note

@enduml
