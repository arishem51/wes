@startuml fig-2-9-1-class-lane-safety
' SDS Figure II-2.9.1 — Class diagram: the Lane Safety Guard
' NEW 2026-08-09. Specified in the SRS (non-UI function #25) and implemented, but
' Section II.2 had no subsection for it. This is the only component allowed to
' revoke a task that is already PICKING_UP.
' Verified against wes/src/cargo/lane-safety.service.ts, domain/lane-safety.policy.ts.
' Render: java -jar plantuml.jar -charset UTF-8 -tpng fig-2-9-1-class-lane-safety.puml
!include _style.iuml
skinparam nodesep 18
skinparam ranksep 30

class LaneSafetyService <<Service, guard>> {
  -laneIndexByZone: Map<zoneId, LaneIndex>
  +clearLaneForNewCargo(sourceZoneId, pickupLocationName): void
  +committedInsideLane(tasks): Set<taskId>
  -preempt(task, newCargoLocationName): void
  -findDeeperPickups(zoneId, newSlot, axes): DeeperPickup[]
  -readAllocatedResources(vehicleNames): Map<vehicle, string[][]>
  -laneIndexOf(zone): LaneIndex?
  -cargoesOf(tasks): Map<cargoId, CargoEntity>
}

class CargoService <<Service>> {
  +create(dto, userId): CargoEntity
}

class AssignmentEngineService <<Engine>> {
  -buildHeldContexts(heldByVehicle, distances): DispatchContext[]
}

package "cargo/domain (framework-free)" {

class "lane-safety.policy" as Policy <<pure/functions>> {
  +isPathResource(resource): boolean
  +allocatedPointNames(resources): string[]
  +allocationReachesPoints(allocated, lanePoints): boolean
  +isDeeperInSameLane(candidate, reference): boolean
}

}

class ZoneGeometryService <<Service>> {
  +computeMemberAxes(zone): Map<string, MemberAxes>
}

class TransportTaskService <<Service, choke-point>> {
  +changeStatus(task, to, log): TransportTaskEntity
}

class KernelApiService <<ACL>> {
  +getVehicleStates(): KernelVehicleState[]
  +withdrawTransportOrder(name, immediate): void
}

class VehicleStateStore <<ACL, in-memory>> {
  +get(name): KernelVehicleState?
  +isConnected(): boolean
}

ZoneGeometryService -[hidden]- TransportTaskService
TransportTaskService -[hidden]- KernelApiService

CargoService --> LaneSafetyService : clearLaneForNewCargo()
AssignmentEngineService --> LaneSafetyService : committedInsideLane()\n(pin a held pickup)
LaneSafetyService ..> Policy
LaneSafetyService --> ZoneGeometryService
LaneSafetyService --> TransportTaskService
LaneSafetyService --> KernelApiService
LaneSafetyService --> VehicleStateStore

note right of LaneSafetyService
  Commitment is read from the kernel's allocated resources,
  not from the task status: a vehicle counts as committed
  once its allocation reaches any point of the lane. A
  committed pickup can no longer be preempted or swapped.
end note

@enduml
