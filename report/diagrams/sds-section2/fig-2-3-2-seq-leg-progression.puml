@startuml fig-2-3-2-seq-leg-progression
' SDS Figure II-2.3.2 — Leg progression: TO1 pick-up -> slot reservation -> TO3
' drop-off and retreat
' Rewritten 2026-08-17: the APPROACH leg (TO2) is retired. On TO1 FINISHED the
' saga reserves a concrete slot under the per-zone advisory lock and aims TO3
' straight at it; the concrete slot is committed later by DropoffCommitLoop
' (Figure II-2.3.3).
' Verified against wes/src/cargo/transport-task.saga.ts.
' Render: java -jar plantuml.jar -charset UTF-8 -tpng fig-2-3-2-seq-leg-progression.puml
!include _style.iuml

actor "openTCS / FMS kernel" as Kernel
participant KernelEventListener as Listener
participant TransportTaskSaga as Saga
participant SlotReservationService as Reserve
participant DeliverySlotEngine as Slots
participant DropoffOrderService as Orders
participant RetreatPointService as Retreat
participant "KernelApiService\n(ACL -> kernel)" as ACL
database PostgreSQL
participant TransportTaskService as TTS

Kernel -> Listener: SSE — transport order FINISHED\n(order props: wes:taskId, wes:leg)
Listener -> Saga: emit fms.transport-order.finished(taskId, leg)
Saga -> Saga: single-flight guard (processing set)

alt leg = PICKUP
  Saga -> PostgreSQL: load task (PICKING_UP) + cargo + destination zone
  opt metadata.to3Name already set
    Saga -> Saga: ignore duplicate TO1 finished
  end
  opt no assigned vehicle, or no destination zone
    Saga -> TTS: changeStatus(task, FAILED)
  end

  Saga -> Reserve: reserve(cargoId, zone)
  Reserve -> Slots: layoutFor(zone)  — before the transaction opens
  Slots -> ACL: getPlantModelView()  (cached, 30 s TTL)
  Slots --> Reserve: ZoneSlotLayout (columns, entryPoints)
  Reserve -> PostgreSQL: BEGIN + pg_advisory_xact_lock(hashtext(zone.id))
  Reserve -> PostgreSQL: SELECT cargos of the zone (ACTIVE, DELIVERED)
  Reserve -> Slots: rank(layout, committed + reserved slots) - BR-11
  Slots --> Reserve: free slots in fill order
  Reserve -> PostgreSQL: UPDATE cargos SET reserved_location_name = slot,\nslot_decision_seq = seq + 1  → COMMIT
  Reserve --> Saga: reserved slot | null

  opt reserved slot is null
    Saga -> Saga: stay PICKING_UP — the reconcile backstop retries
  end

  Saga -> Orders: issue(task, vehicle, slot)
  Orders -> Retreat: pathFor(slot)
  Retreat --> Orders: retreat path | null (warning)
  Orders -> ACL: createTransportOrder(TO3-...,\n[unload @ slot, MOVE @ retreat cells], vehicle)
  Orders -> PostgreSQL: save metadata.to3Name, metadata.retreatPointName
  Orders --> Saga: order name
  Saga -> TTS: changeStatus(task, DELIVERING)

else leg = DROPOFF
  Saga -> PostgreSQL: load task (DELIVERING)
  Saga -> TTS: changeStatus(task, DELIVERY_COMPLETED)
  Saga -> PostgreSQL: UPDATE cargos SET status = DELIVERED
end

== unload observed mid-TO3 ==

Kernel -> Listener: SSE — unload operation done
Listener -> Saga: emit fms.dropoff.unloaded(taskId)
Saga -> PostgreSQL: save metadata.unloadedAt\n(retreat leg still running)

note over Saga, ACL
  There is no approach order and no shared approach point: the vehicle
  drives from the pick-up straight to the slot reserved for its cargo.
  That reservation is still provisional — DropoffCommitLoop turns it
  into the binding commitment on arrival (Figure II-2.3.3).
end note

@enduml
