' Shared style for the Report 3 use-case diagrams (SRS Section II.1.3.3)
' Matches the main-workflow activity diagrams: Arial 12, #7ACFF4 fill, black lines.
' Usage: !include uc-style.iuml

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam ArrowColor #000000
skinparam ArrowFontSize 11
skinparam PackageTitleAlignment center
skinparam ranksep 55
skinparam nodesep 22

skinparam usecase {
  BackgroundColor #7ACFF4
  BorderColor #000000
  BorderThickness 1
  FontSize 12
}

skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontSize 12
  FontStyle bold
}

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #000000
  BorderThickness 1
  FontStyle bold
  FontSize 13
}

skinparam note {
  BackgroundColor #FFF8DC
  BorderColor #999999
  FontSize 11
}
