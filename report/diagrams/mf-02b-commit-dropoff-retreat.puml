@startuml mf-02b-commit-dropoff-retreat
' SRS Section II.1.2.2 — Main Workflow: Delivery, part B (Commit, Drop-off & Retreat)
' Continues from mf-02a-reserve-aim.puml
' Supersedes mf-02b-dropoff-retreat.puml: the slot is now committed at the zone
' gate by a periodic watch, and a late arrival may swap a slot away from a
' reservation that has not been committed yet.
' Business-level vocabulary only; implementation detail belongs in the SDS.
' Render: java -jar plantuml.jar -charset UTF-8 -tpng mf-02b-commit-dropoff-retreat.puml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam swimlaneWidth 260
skinparam ArrowColor #000000
skinparam ActivityBorderColor #000000
skinparam ActivityBackgroundColor #7ACFF4
skinparam ActivityDiamondBorderColor #000000
skinparam ActivityDiamondBackgroundColor #7ACFF4
skinparam NoteBackgroundColor #7ACFF4
skinparam NoteBorderColor #000000

|FMS (openTCS)|
|WES|
|AGV|

|WES|
start
:Watch every delivering vehicle\nthat has no committed slot yet;
note right: Continued from part A\n(Reserve & Aim)
repeat
  :Read where the assigned vehicle stands;
  backward:Re-check on the next tick (0.5 s);
repeat while (Has it reached\nthe destination zone?) is (Not yet) not (Yes)
:Take exclusive access\nto the zone's slot map;
if (Is it standing at the zone gate?) then (Yes - it can still pick another column)
  :Choose the best slot the fill rule (BR-11)\noffers among the slots\nnot committed by anyone;
else (No - it is already inside the zone)
  :Keep its own reserved slot, unless\nanother vehicle has already committed it;
endif
if (Does the fill rule offer a slot?) then (No)
  :Release the zone;
  :Log a warning;\nthe next tick tries again;
  stop
else (Yes)
endif
:Record the committed slot on the cargo\nand drop its reservation;
:Release the zone;
note right: A committed slot is final -\nit can never be taken away again
if (Was that slot another cargo's reservation?) then (Yes)
  :Re-reserve that cargo to the next slot\nthe fill rule offers;
  :Withdraw and re-issue\nthat vehicle's drop-off transport order;
  :Count the swap on that request;
  note right: The zone was capacity-checked when the request\nwas created, so a displaced cargo always\nhas a slot left to move to
else (No)
endif
if (Is the committed slot the one\nthis vehicle was aimed at?) then (No)
  :Withdraw and re-issue this vehicle's\ndrop-off transport order\nat the committed slot;
else (Yes)
endif

|FMS (openTCS)|
:Route the vehicle\nto the committed slot;

|AGV|
:Unload the cargo at the slot;

|FMS (openTCS)|
:Notify WES that the cargo\nhas been unloaded;

|WES|
:Record that the cargo has been unloaded;
note right: The task is STILL DELIVERING -\nthe retreat steps are running

|AGV|
:Retreat 2 cells clear of the slot;

|FMS (openTCS)|
:The drop-off transport order\nreaches FINISHED;

|WES|
:Task -> DELIVERY_COMPLETED;
:Cargo -> DELIVERED;
stop

@enduml
