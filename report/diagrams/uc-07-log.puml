@startuml uc-07-log
' SRS Section II.1.3.3.7 — UCs for Event Log & Audit Trail
' Use cases taken verbatim from the UC table in Section II.1.3.2 (LOG group).
' UC 100-103 (system event browsing) and UC 109 (log export) were withdrawn on
' 04/08/2026 and are deliberately absent.
' Render: java -jar plantuml.jar -charset UTF-8 -tpng uc-07-log.puml
!pragma layout smetana
!include uc-style.iuml
left to right direction


actor Admin as ADM

rectangle "SWES" {
  usecase "UC 104\nView AGV\nchange history" as UC104
  usecase "UC 105\nView topology\nchange history" as UC105
  usecase "UC 106\nView dispatch configuration\nchange history" as UC106
  usecase "UC 107\nView user\naction history" as UC107
  usecase "UC 108\nView details of\na user session" as UC108
}

ADM --> UC104
ADM --> UC105
ADM --> UC106
ADM --> UC107
ADM --> UC108

legend bottom
  All five are served by one Audit Log screen, available to the Admin role only;
  UC 104 to UC 106 differ only in the entity-type filter applied to it.
endlegend

@enduml
