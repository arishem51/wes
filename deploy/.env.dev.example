COMPOSE_PROJECT_NAME=wes-dev-hung
DOCKERHUB_NAMESPACE=aubot
IMAGE_TAG=dev-20260908-01
PUBLIC_URL=http://dev-server.example.com:18080
WES_BIND_ADDRESS=127.0.0.1
WES_HTTP_PORT=18080

OPENTCS_BIND_ADDRESS=127.0.0.1
OPENTCS_HTTP_PORT=59200
OPENTCS_RMI_BIND_ADDRESS=100.92.46.11
OPENTCS_RMI_ADVERTISED_HOST=100.92.46.11

MQTT_NETWORK_NAME=fms_default

POSTGRES_USER=wes
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=wes
JWT_SECRET=replace-with-at-least-32-random-characters

OPENTCS_MAP_AUTO_LOAD=false
OPENTCS_MAP_PATH=maps/v7-vda5050.xml
DISPATCH_MATCHER=hungarian
VEHICLE_TYPE=vda5050

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
